# MinIO S3 Storage Credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# PostgreSQL Database Credentials (Airflow Metadata Backend)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Apache Airflow Configuration
AIRFLOW_USERNAME=admin
WINDOW=5

# MLflow: local SQLite + artifacts in .mlflow/ when URI is unset
MLFLOW_ENABLED=true
MLFLOW_EXPERIMENT_NAME=financial-forecasting-xgboost
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# MLFLOW_RUN_NAME=baseline-h36
# MLFLOW_REGISTERED_MODEL_NAME=financial-direction-xgboost
